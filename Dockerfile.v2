FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

WORKDIR /app

COPY requirements-v2.lock .
RUN pip install --no-cache-dir -r requirements-v2.lock

COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini

EXPOSE 5000

CMD ["gunicorn", "-b", "0.0.0.0:5000", "nemsei.wsgi:app"]

FROM runtime AS acceptance

COPY requirements-v2-dev.lock .
RUN pip install --no-cache-dir -r requirements-v2-dev.lock
COPY acceptance_src/ ./src/

# Keep the final/default image free of test dependencies and acceptance-only
# worker behavior. CI must opt in with `--target acceptance`.
FROM runtime AS production
