NEMSEI_V2_ENV=preview
NEMSEI_V2_HOST_DATA_ROOT=/opt/server/apps/Nem-sei-v2-data
# Secret files are host-local and ignored by Git. Compose mounts these as
# Docker secrets; the application reads the complete database URL from the
# in-container path below.
NEMSEI_V2_DATABASE_URL_FILE=/run/secrets/v2_database_url
NEMSEI_V2_DATABASE_URL_SECRET_FILE=./secrets/v2_database_url
NEMSEI_V2_POSTGRES_PASSWORD_SECRET_FILE=./secrets/v2_postgres_password
NEMSEI_V2_SECRET_KEY=
NEMSEI_V2_ADMIN_USERNAME=admin
# Compose interpolates this file, so EVERY literal `$` must be written `$$`.
# A Werkzeug hash looks like `scrypt:32768:8:1$salt$hash`; written unescaped,
# Compose expands `$salt` and `$hash` as undefined variables and the container
# receives a truncated `scrypt:32768:8:1`, which fails validation at startup.
# Correct form:  NEMSEI_V2_ADMIN_PASSWORD_HASH=scrypt:32768:8:1$$salt$$hash
# The same escaping applies to any other value containing `$`.
NEMSEI_V2_ADMIN_PASSWORD_HASH=
NEMSEI_V2_PROVIDER_READS=false
NEMSEI_V2_PROVIDER_MUTATIONS=false
NEMSEI_V2_NOTIFICATIONS=false
NEMSEI_V2_REPORT_DISTRIBUTION=false
# A FusionSolar connection stores only a credential reference such as
# `primary`. Supply its secrets separately; never add credentials to the DB.
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_USERNAME_FILE=/run/secrets/fusionsolar_primary_username
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_PASSWORD_FILE=/run/secrets/fusionsolar_primary_password
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_BASE_URL=https://configured-provider-host
# Set these only after the provider-day timezone and PVYield unit for this
# connection have been verified. The production adapter has no default.
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_PRODUCTION_TIMEZONE=Europe/Lisbon
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_PRODUCTION_UNIT=kWh
# Same discipline for device-level status (M7 Fatia 2, docs/v2/DEVICE_TELEMETRY.md):
# set only after a live canary confirms getDevRealKpi's active-power unit for
# this account (V1 guessed it from magnitude; V2 refuses to). Day energy must
# be verified kWh, same as production.
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_DEVICE_POWER_UNIT=kW
# NEMSEI_V2_FUSIONSOLAR_PRIMARY_DEVICE_ENERGY_UNIT=kWh

# Sigenergy read-only credential reference. App key/secret may be mounted
# files; never store them in PostgreSQL, source, images, or tracked env files.
# NEMSEI_V2_SIGENERGY_PRIMARY_APP_KEY_FILE=/run/secrets/sigenergy_primary_app_key
# NEMSEI_V2_SIGENERGY_PRIMARY_APP_SECRET_FILE=/run/secrets/sigenergy_primary_app_secret
# NEMSEI_V2_SIGENERGY_PRIMARY_BASE_URL=https://api-eu.sigencloud.com
# NEMSEI_V2_SIGENERGY_PRIMARY_AUTH_ENDPOINT=/openapi/auth/login/key
# NEMSEI_V2_SIGENERGY_PRIMARY_SYSTEMS_ENDPOINT=/openapi/system/list
# NEMSEI_V2_SIGENERGY_PRIMARY_ENERGY_FLOW_ENDPOINT=/openapi/systems/{system_id}/energyFlow
# NEMSEI_V2_SIGENERGY_PRIMARY_REGION=eu
# Application safety cap for one normal daily-production sync; larger history
# work requires a future explicit bounded backfill process.
NEMSEI_V2_PRODUCTION_MAX_SOURCE_DAYS=31
# Explicit reconciliation and bounded-backfill safeguards. The scheduler never
# runs these modes; jobs must be requested with explicit, non-secret payloads.
NEMSEI_V2_PRODUCTION_RECONCILIATION_MAX_SOURCE_DAYS=3
NEMSEI_V2_PRODUCTION_BACKFILL_MAX_SOURCE_DAYS=366
NEMSEI_V2_PRODUCTION_BACKFILL_CHUNK_DAYS=31
# Production/preview deployment must use scripts/v2_compose_up.sh. Do not set
# NEMSEI_V2_TESTING outside the dedicated acceptance stack.

# --- Huawei SCADA (docs/v2/HUAWEI_SCADA.md) ---------------------------------
# The only inbound integration in V2: the SDongle dials this server, and the
# server answers by reading Modbus registers back over that connection. No
# account, no credential, no outbound call, no edge collector.
#
# Where to listen. The default is loopback only, so nothing is exposed until
# an operator states an interface. The public port lives in the router's NAT
# rule and never in this repository -- neither the address nor the public port
# is hardcoded anywhere in code or Compose.
# NEMSEI_V2_SCADA_BIND_ADDRESS=192.168.1.237
# NEMSEI_V2_SCADA_BIND_PORT=1502
# The provider connection the listener binds to. There is no portfolio-wide
# mode: one listener, one connection, enforced by config validation and by a
# Postgres advisory lock at runtime.
# NEMSEI_V2_HUAWEI_SCADA_CONNECTION_ID=6
# The poll is also the keep-alive, so it must be shorter than the idle timeout
# (validated, not merely recommended).
# NEMSEI_V2_HUAWEI_SCADA_POLL_INTERVAL_SECONDS=30
# NEMSEI_V2_HUAWEI_SCADA_IDLE_TIMEOUT_SECONDS=300
#
# The verified register contract. Set per credential reference, and required:
# the rollup refuses to convert power into energy without them rather than
# guessing which register means production.
# NEMSEI_V2_HUAWEI_SCADA_PRIMARY_POWER_UNIT=kW
# NEMSEI_V2_HUAWEI_SCADA_PRIMARY_PRODUCTION_SIGNAL=total_active_power
# Leave unset until a real meter comparison settles which direction positive
# means on register 37502. While unset, export and grid import are simply not
# written -- half-right is not an option here.
# NEMSEI_V2_HUAWEI_SCADA_PRIMARY_GRID_SIGN_CONVENTION=positive_import
# NEMSEI_V2_HUAWEI_SCADA_PRIMARY_SELF_USE_DERIVATION=consumption_minus_grid_import
# NEMSEI_V2_HUAWEI_SCADA_PRIMARY_MAX_SAMPLE_GAP_SECONDS=900
#
# Power-to-energy rollup and sample retention: ordinary durable jobs in the
# worker, over rows already in the database. Zero provider calls.
# NEMSEI_V2_HUAWEI_SCADA_ROLLUP_ENABLED=true
# NEMSEI_V2_HUAWEI_SCADA_ROLLUP_CONNECTION_ID=6
# NEMSEI_V2_HUAWEI_SCADA_ROLLUP_LOOKBACK_DAYS=2
# NEMSEI_V2_HUAWEI_SCADA_RETENTION_ENABLED=true
# NEMSEI_V2_HUAWEI_SCADA_RETENTION_DAYS=90
